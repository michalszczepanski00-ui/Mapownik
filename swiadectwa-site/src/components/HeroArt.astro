---
// Ilustracje do nagłówków stron: rysowane linią, w motywie strony (bez zdjęć stockowych).
interface Props { kind: 'plan' | 'cert' | 'docs' | 'blocks' }
const { kind } = Astro.props;
const classes: [string, number, string][] = [['A+', 100, '#2de2d0'], ['A', 86, '#5fe6d8'], ['B', 72, '#8fd9d0'], ['C', 58, '#3a9aa0'], ['D', 44, '#2a7e88']];
---
<div class="art rv" aria-hidden="true">
  {kind === 'plan' && (
    <svg viewBox="0 0 440 360" class="art-svg art-plan">
      <rect x="10" y="10" width="420" height="340" rx="36" fill="rgba(255,255,255,.05)" stroke="rgba(190,242,233,.25)" style="stroke-dasharray:none;stroke-dashoffset:0"/>
      <rect x="70" y="120" width="150" height="190"/><rect x="220" y="190" width="120" height="120"/>
      <path d="M70 120 L145 70 L220 120"/><path d="M220 190 L280 150 L340 190"/><line x1="40" y1="310" x2="400" y2="310"/>
      <rect x="92" y="146" width="30" height="30"/><rect x="138" y="146" width="30" height="30"/><rect x="92" y="204" width="30" height="30"/><rect x="138" y="204" width="30" height="30"/>
      <rect x="244" y="214" width="28" height="28"/><rect x="288" y="214" width="28" height="28"/>
      <path d="M345 70 h50 M345 90 h34 M345 110 h42" />
      <circle cx="372" cy="46" r="0"/>
    </svg>
  )}
  {kind === 'cert' && (
    <div class="cert-art">
      <div class="cert-card">
        <b>Świadectwo charakterystyki energetycznej</b>
        <div class="scale">
          {classes.map(([l, w, c]) => (<div class="srow"><span>{l}</span><i style={`--w:${w}%;background:${c}`}></i></div>))}
        </div>
        <div class="lines"><s></s><s></s><s></s></div>
      </div>
      <div class="cert-badge">Budynek · Lokal · Pakiet</div>
    </div>
  )}
  {kind === 'docs' && (
    <div class="docs-art">
      <div class="doc doc-1"><b>Dokumentacja projektowa</b><s></s><s></s><s></s></div>
      <div class="doc doc-2"><b>Dane wejściowe</b><s></s><s></s><s></s></div>
      <div class="doc doc-3"><b>Projektowana charakterystyka</b><s></s><s></s><em>✓ gotowe do projektu</em></div>
    </div>
  )}
  {kind === 'blocks' && (
    <svg viewBox="0 0 440 360" class="art-svg art-blocks">
      <rect x="10" y="10" width="420" height="340" rx="36" fill="rgba(255,255,255,.05)" stroke="rgba(190,242,233,.25)" style="stroke-dasharray:none;stroke-dashoffset:0"/>
      <line x1="40" y1="310" x2="400" y2="310"/>
      <rect x="50" y="170" width="70" height="140"/><rect x="130" y="110" width="80" height="200"/><rect x="220" y="150" width="70" height="160"/><rect x="300" y="200" width="90" height="110"/>
      <path d="M62 196h12M86 196h12M62 226h12M86 226h12M62 256h12M86 256h12M146 140h14M170 140h14M146 176h14M170 176h14M146 212h14M170 212h14M146 248h14M170 248h14M234 180h12M258 180h12M234 214h12M258 214h12M234 248h12M258 248h12M316 226h14M344 226h14M316 262h14M344 262h14"/>
    </svg>
  )}
</div>
