---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, mailto } from '../data/site';
const steps = [
  ['Rodzaj opracowania', 'Napisz, czy chodzi o projektowaną charakterystykę, świadectwo energetyczne, pakiet świadectw albo stałą współpracę.'],
  ['Typ budynku', 'Podaj, czy jest to budynek wielorodzinny, biurowy, usługowy, hala, magazyn, lokal albo inny obiekt.'],
  ['Lokalizacja', 'Wskaż miejscowość lub lokalizację inwestycji, jeżeli ma znaczenie dla dokumentacji lub zakresu danych.'],
  ['Dostępna dokumentacja', 'Dodaj informację, czy posiadasz projekt, rzuty, opis techniczny, dane instalacji albo wcześniejsze opracowania.'],
  ['Liczba obiektów', 'Przy pakietach wskaż liczbę lokali, budynków lub świadectw, które mają zostać przygotowane.'],
  ['Termin', 'Podaj oczekiwany termin realizacji, jeżeli jest istotny dla inwestycji, sprzedaży, najmu lub zamknięcia dokumentacji.'],
];
---
<Base
  title="Kontakt i wycena | świadectwa.net"
  description="Kontakt w sprawie projektowanych charakterystyk energetycznych, świadectw energetycznych, pakietów świadectw i stałej współpracy B2B."
  path="/kontakt/"
  breadcrumbs={[{ name: 'Kontakt', path: '/kontakt/' }]}
>
  <PageHero
    tag="Kontakt i wycena"
    title='Wyślij zapytanie <span class="grad">o dokumentację energetyczną</span>'
    lead={['Najlepszą formą kontaktu jest e-mail z krótkim opisem budynku, zakresem potrzebnego opracowania i dostępną dokumentacją. Po analizie przygotujemy indywidualną wycenę.']}
    crumbs={[{ name: 'Kontakt', path: '/kontakt/' }]}
    mail={{ subject: 'Zapytanie o dokumentację energetyczną', label: site.email }}
  />

  <section class="pad" aria-labelledby="kontakt-h">
    <div class="wrap two">
      <div>
        <span class="tag rv"><i></i>Kontakt</span>
        <h2 id="kontakt-h" class="rv d1" style="margin:22px 0 18px">Kontakt <span class="grad">e-mailowy</span></h2>
        <p class="lede rv d2">Kontakt prowadzimy przede wszystkim e-mailowo, co ułatwia przekazanie dokumentacji i zachowanie historii ustaleń.</p>
      </div>
      <dl class="kv rv d2">
        <dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        <dt>Telefon</dt><dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
        <dt>Obszar działania</dt><dd>Pracujemy zdalnie z klientami z całej Polski. Lokalnie firma jest związana z Gdańskiem i Starogardem Gdańskim.</dd>
        <dt>Lokalizacje</dt><dd>Gdańsk / Starogard Gdański</dd>
        <dt>Dokumenty formalne</dt><dd><a href="/dane-rejestrowe/">Dane rejestrowe</a><br /><a href="/polityka-prywatnosci/">Polityka prywatności</a></dd>
      </dl>
    </div>
  </section>

  <section class="pad band-soft" aria-labelledby="przygotuj-h">
    <div class="wrap">
      <div class="sec-head">
        <span class="tag rv"><i></i>Jak przygotować zapytanie</span>
        <h2 id="przygotuj-h" class="rv d1">Co warto podać <span class="grad">w wiadomości</span></h2>
        <p class="rv d2">Nie musisz przygotowywać długiego opisu. Wystarczy kilka informacji, które pozwolą ocenić zakres i przygotować wycenę.</p>
      </div>
      <div class="cols-3">
        {steps.map(([t, d], i) => (
          <div class={`card flow rv d${i % 3}`}><span class="kick">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad" aria-labelledby="pomoc-h">
    <div class="wrap two">
      <div>
        <span class="tag rv"><i></i>Najczęstsze zapytania</span>
        <h2 id="pomoc-h" class="rv d1" style="margin:22px 0 18px">W czym <span class="grad">możemy pomóc</span></h2>
        <ul class="check rv d2">
          <li>projektowana charakterystyka energetyczna do projektu budowlanego,</li>
          <li>świadectwo charakterystyki energetycznej dla budynku komercyjnego,</li>
          <li>pakiet świadectw dla lokali lub budynków,</li>
          <li>stała współpraca z biurem projektowym,</li>
          <li>weryfikacja zakresu danych potrzebnych do opracowania.</li>
        </ul>
      </div>
      <div class="note rv d2"><span class="kick">Najprostszy sposób rozpoczęcia</span><h3>Wyślij wiadomość z krótkim opisem</h3>
        <p>Jeżeli do wyceny będą potrzebne dodatkowe dane, wskażemy je po wstępnej analizie.</p>
        <a class="btn btn-teal" href={mailto('Zapytanie ze strony świadectwa.net')}>Wyślij e-mail <span class="ar" aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <CtaBand title="Przygotuj zapytanie" text="Wypełnij kilka pól, a przygotujemy treść wiadomości do wysłania z Twojego programu pocztowego." />
</Base>
