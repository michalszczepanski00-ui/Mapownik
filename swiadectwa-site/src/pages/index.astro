---
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import { audiences } from '../data/audiences.js';
const services = [
  { t: 'Projektowa charakterystyka energetyczna', d: 'Opracowanie do projektu budowlanego zgodnie z obowiązującymi warunkami technicznymi. Dla pracowni i deweloperów, na każdym etapie projektu.', href: '/oferta#charakterystyka' },
  { t: 'Świadectwa energetyczne', d: 'Świadectwa charakterystyki energetycznej dla budynków i lokali, także seryjnie, dla całych inwestycji deweloperskich.', href: '/oferta#swiadectwa' },
  { t: 'Analizy źródeł energii', d: 'Pompy ciepła, fotowoltaika, magazyny energii. Analiza opłacalności i wpływu na wskaźniki EP.', href: '/oferta#dodatkowe' },
];
const why = [
  { t: 'Termin na starcie', d: 'Czas realizacji ustalamy na początku zlecenia, więc możesz zaplanować kolejne etapy projektu.' },
  { t: 'Płatność po dostawie', d: 'Płacisz dopiero po otrzymaniu gotowego dokumentu.' },
  { t: 'Profesjonalne narzędzia', d: 'Pracujemy na profesjonalnym oprogramowaniu i sprzęcie pomiarowym.' },
  { t: 'Cała Polska', d: 'Obsługujemy inwestycje zdalnie, bez względu na lokalizację.' },
];
const steps = [
  { t: 'Zapytanie', d: 'Wysyłasz dane inwestycji i dokumentację projektową przez formularz.' },
  { t: 'Wycena i termin', d: 'Przygotowujemy indywidualną ofertę. Termin realizacji ustalamy na początku zlecenia.' },
  { t: 'Opracowanie', d: 'Wykonujemy analizę na profesjonalnym oprogramowaniu i konsultujemy ewentualne korekty.' },
  { t: 'Dokumenty', d: 'Przekazujemy gotowe opracowanie. Płatność dopiero po dostarczeniu dokumentu.' },
];
const faq = [
  { q: 'Dla kogo jest oferta?', a: 'Dla firm z branży budowlanej: biur projektowych, deweloperów i architektów. Nie obsługujemy klientów indywidualnych.' },
  { q: 'Jak wyceniacie zlecenia?', a: 'Każde zlecenie wyceniamy indywidualnie na podstawie dokumentacji projektowej i zakresu opracowania.' },
  { q: 'Ile trwa realizacja?', a: 'Termin ustalamy zawsze na początku zlecenia, po zapoznaniu się z dokumentacją.' },
  { q: 'Kiedy płacę?', a: 'Płatność następuje po dostarczeniu gotowego dokumentu.' },
  { q: 'Czy pracujecie poza Pomorzem?', a: 'Tak, obsługujemy inwestycje w całej Polsce, zdalnie.' },
];
const classes = [['A+',96],['A',84],['B',72],['C',60],['D',48],['E',38],['F',28],['G',20]];
---
<Base title="swiadectwa.net – charakterystyka energetyczna dla biur projektowych i deweloperów">
  <section class="hero">
    <div class="wrap">
      <div>
        <div class="badge"><i></i>Analizy energetyczne dla branży budowlanej</div>
        <h1>Charakterystyka energetyczna <em>bez opóźnień.</em></h1>
        <p class="lead">Wspieramy biura projektowe, deweloperów i architektów w całej Polsce. Opracowania do projektów budowlanych i świadectwa energetyczne, z terminem uzgodnionym na starcie.</p>
        <div class="actions">
          <a class="btn btn-mint" href="/kontakt#wycena">Zapytaj o wycenę</a>
          <a class="btn btn-glass" href="/oferta">Zobacz ofertę</a>
        </div>
      </div>
      <div class="scale" aria-hidden="true">
        <h3>Klasa energetyczna budynku</h3>
        {classes.map(([l,w]) => (<div class={`bar${l==='A'?' a':''}`}><b>{l}</b><span style={`width:${w}%`}></span></div>))}
      </div>
    </div>
  </section>

  <section class="stats"><div class="wrap"><div class="grid">
    <div class="stat"><b>600+</b><span>wykonanych analiz energetycznych</span></div>
    <div class="stat"><b>Cała Polska</b><span>obsługa zdalna inwestycji</span></div>
    <div class="stat"><b>Po dostawie</b><span>płatność po odbiorze dokumentu</span></div>
  </div></div></section>

  <section>
    <div class="wrap">
      <Tag t="Nasza oferta" />
      <h2 style="max-width:18ch">Specjalizacja: projektowa charakterystyka energetyczna</h2>
      <p class="lead">Kluczowe usługi dla inwestycji budowlanych, w jednym miejscu i z jednym wykonawcą.</p>
      <div class="grid-3">
        {services.map((s,i) => (
          <a class="card" href={s.href} style="text-decoration:none"><div class="num">0{i+1}</div><h3>{s.t}</h3><p>{s.d}</p><div class="go"><i>→</i></div></a>
        ))}
      </div>
    </div>
  </section>

  <section class="soft" id="dla-kogo">
    <div class="wrap">
      <Tag t="Dla kogo" />
      <h2 style="max-width:20ch">Pracujemy z firmami z branży budowlanej</h2>
      <p class="lead">Jesteśmy partnerem dla profesjonalistów. Obsługujemy wyłącznie klientów biznesowych.</p>
      <div class="grid-3">
        {audiences.map(a => (
          <a class="card mint" href={`/dla-kogo/${a.slug}`} style="text-decoration:none"><h3 style="font-size:1.5rem;margin-bottom:1em">{a.name}</h3><p>{a.short}</p><div class="go"><i>→</i></div></a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Tag t="Dlaczego my" />
      <h2>Współpraca bez niespodzianek</h2>
      <div class="grid-3" style="grid-template-columns:repeat(auto-fit,minmax(230px,1fr))">
        {why.map(w => (<div class="card"><h3>{w.t}</h3><p>{w.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="soft" id="proces">
    <div class="wrap">
      <Tag t="Jak pracujemy" />
      <h2>Prosty proces, przewidywalny wynik</h2>
      <div class="steps">
        {steps.map(s => (<div class="step"><h3>{s.t}</h3><p>{s.d}</p></div>))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap" style="max-width:860px">
      <div class="center"><Tag t="Częste pytania" /><h2>FAQ</h2></div>
      <div style="margin-top:36px">
        {faq.map(f => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="cta center">
    <div class="wrap">
      <div class="glass">
        <Tag t="Zapytaj teraz" />
        <h2>Masz projekt do opracowania?</h2>
        <p class="lead">Prześlij zapytanie. Przygotujemy indywidualną wycenę i zaproponujemy termin.</p>
        <a class="btn btn-teal" href="/kontakt#wycena">Zapytaj o wycenę</a>
      </div>
    </div>
  </section>
</Base>
