---
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import { audiences } from '../../data/audiences.js';
export function getStaticPaths() {
  return audiences.map(a => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
---
<Base title={`${a.name} – ${a.headline} | swiadectwa.net`} description={a.intro}>
  <div class="page-head"><div class="wrap">
    <Tag t="Dla kogo" dark />
    <h1>{a.headline}</h1>
    <p>{a.intro}</p>
  </div></div>
  <section><div class="wrap two-col">
    <div>
      <h2>Co zyskujesz</h2>
      <ul class="checks">{a.benefits.map(b => <li>{b}</li>)}</ul>
      <p><a class="btn btn-teal" href="/kontakt#wycena">Zapytaj o wycenę</a></p>
    </div>
    <div class="card mint">
      <h3>Jak to wygląda w praktyce</h3>
      <p>Wysyłasz zapytanie z danymi inwestycji. Przygotowujemy indywidualną wycenę, a termin ustalamy na początku zlecenia. Płatność następuje po dostarczeniu gotowego dokumentu.</p>
    </div>
  </div></section>
  <section class="soft"><div class="wrap center">
    <h2>Pozostałe grupy klientów</h2>
    <div class="grid-3">
      {audiences.filter(x => x.slug !== a.slug).map(x => (
        <a class="card" href={`/dla-kogo/${x.slug}`} style="text-decoration:none;text-align:left"><h3>{x.name}</h3><p>{x.short}</p><div class="go"><i>→</i></div></a>
      ))}
    </div>
  </div></section>
</Base>
