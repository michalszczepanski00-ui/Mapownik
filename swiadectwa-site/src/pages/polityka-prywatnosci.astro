---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import polityka from '../data/polityka.html?raw';
---
<Base
  title="Polityka prywatności | świadectwa.net"
  description="Polityka prywatności serwisu świadectwa.net. Informacje o przetwarzaniu danych, cookies i prawach użytkowników."
  path="/polityka-prywatnosci/"
  breadcrumbs={[{ name: 'Polityka prywatności', path: '/polityka-prywatnosci/' }]}
>
  <PageHero tag="Dokument prawny" title='Polityka <span class="grad">prywatności</span>' lead={['Informacje o zasadach przetwarzania danych osobowych, wykorzystaniu plików cookies oraz prawach osób kontaktujących się przez serwis świadectwa.net.']} crumbs={[{ name: 'Polityka prywatności', path: '/polityka-prywatnosci/' }]} />
  <section class="pad">
    <div class="wrap"><div class="prose" set:html={polityka} /></div>
  </section>
</Base>
