---
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services.js';
export function getStaticPaths() { return services.map(s => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props;
const others = services.filter(x => x.slug !== s.slug).slice(0, 3);
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: s.name, description: s.intro, provider: { '@type': 'ProfessionalService', name: 'swiadectwa.net', url: 'https://swiadectwa.net' }, areaServed: 'PL' };
---
<Base title={`${s.name} | swiadectwa.net`} description={s.intro}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="page-head"><div class="wrap">
    <Tag t="Oferta" dark />
    <h1 style="max-width:20ch">{s.headline}</h1>
    <p>{s.intro}</p>
    <p style="margin-top:28px"><a class="btn btn-mint" href="/kontakt#wycena">Zapytaj o wycenę</a></p>
  </div></div>

  <section><div class="wrap two-col">
    <div>
      <Tag t="Kiedy to potrzebne" />
      <h2>Kiedy warto zamówić</h2>
      <ul class="checks">{s.when.map(w => <li>{w}</li>)}</ul>
    </div>
    <div class="card mint">
      <div class="ico"><Icon name={s.icon} size={34} /></div>
      <h3 style="font-size:1.4rem">Co otrzymujesz</h3>
      <ul class="checks" style="margin-bottom:0">{s.deliver.map(d => <li>{d}</li>)}</ul>
    </div>
  </div></section>

  <section class="soft"><div class="wrap" style="max-width:860px">
    <div class="center"><Tag t="Częste pytania" /><h2>Pytania o tę usługę</h2></div>
    <div style="margin-top:32px">{s.faq.map(f => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
  </div></section>

  <section><div class="wrap">
    <Tag t="Inne usługi" />
    <h2>Zobacz także</h2>
    <div class="grid-3">
      {others.map(o => (
        <a class="card" href={`/oferta/${o.slug}`} style="text-decoration:none"><div class="ico"><Icon name={o.icon} /></div><h3>{o.name}</h3><p>{o.short}</p><div class="go"><i>→</i></div></a>
      ))}
    </div>
  </div></section>

  <section class="cta center"><div class="wrap"><div class="glass">
    <Tag t="Zapytaj teraz" />
    <h2>Opisz inwestycję, a przygotujemy wycenę</h2>
    <p class="lead">Termin realizacji ustalamy na początku zlecenia. Płatność po dostarczeniu dokumentu.</p>
    <a class="btn btn-teal" href="/kontakt#wycena">Zapytaj o wycenę</a>
  </div></div></section>
</Base>
